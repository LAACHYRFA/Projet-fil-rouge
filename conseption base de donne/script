-- 1. Table des utilisateurs
CREATE TABLE utilisateur (
    id_utilisateur INT PRIMARY KEY AUTO_INCREMENT,
    nom_completed VARCHAR(100),
    email VARCHAR(100) UNIQUE,
    password VARCHAR(255),
    telephone VARCHAR(20)
);

-- 2. Table des abonnements
CREATE TABLE abonnement (
    id_ab INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100),
    duree VARCHAR(50),
    prix_total DECIMAL(10, 2),
    description TEXT
);

-- 3. Table des inscriptions (Table pivot)
CREATE TABLE inscription (
    id_inscription INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur INT,
    id_ab INT,
    date_inscription DATE,
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateur(id_utilisateur) ON DELETE CASCADE,
    FOREIGN KEY (id_ab) REFERENCES abonnement(id_ab) ON DELETE CASCADE
);

-- 4. Table des messages
CREATE TABLE message (
    id_msg INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur INT,
    nom VARCHAR(100),
    email VARCHAR(100),
    contenu TEXT,
    date_envoi DATETIME,
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateur(id_utilisateur) ON DELETE CASCADE
);

-- 5. Table des coachs
CREATE TABLE coach (
    id_coach INT PRIMARY KEY AUTO_INCREMENT,
    nom_complet VARCHAR(100),
    image VARCHAR(255),
    specialite VARCHAR(100),
    email VARCHAR(100),
    telephone VARCHAR(20)
);

-- 6. Table des équipements
CREATE TABLE equipement (
    id_eq INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100),
    image VARCHAR(255),
    categorie VARCHAR(100),
    quantite INT,
    etat VARCHAR(50)
);
